<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:macros="sap.fe.macros"
core:require="{ MyFormatter: 'worklist/model/formatter' }">
	<VBox id="_IDGenVBox1" class="sapUiSmallMargin">
        <Label id="_IDGenLabel11" text="Product Name" design="Bold"/>
        <Text id="_IDGenText116" text="{productName}"></Text>

        <Label id="_IDGenLabel12" text="Price" design="Bold" />
        <Text id="_IDGenText17" text="{price} USD" />

        <Label id="_IDGenLabel112" text="Availability Status" design="Bold" />
        <ObjectStatus id="_IDGenObjectStatus15" 
            text="{path: 'isFinished', formatter: 'MyFormatter.availabilityText'}" 
            state="{path: 'isFinished', formatter: 'MyFormatter.availabilityState'}" />
            
        <Label id="_IDGenLabel13" text="Current Stock" design="Bold" />
        <StepInput id="_IDGenStepInput1" value="{stock}" min="0" width="120px" /> 
	</VBox>
</core:FragmentDefinition>