<mvc:View controllerName="basic.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">
   

        <Table id="productTable" 
       items="{path: '/Products', parameters: {'$expand': 'category,supplier'}}">
    <columns>
        <Column id="_IDGenColumn"><Text id="_IDGenText2" text="Product Name"/></Column>
        <Column id="_IDGenColumn1"><Text id="_IDGenText3" text="Category"/></Column>
        <Column id="_IDGenColumn2"><Text id="_IDGenText4" text="Supplier"/></Column>
    </columns>
    <items>
        <ColumnListItem id="_IDGenColumnListItem" type="Navigation" press="onPress">
            <cells>
                <Text id="_IDGenText5" text="{productName}"/>
                <Text id="_IDGenText8" text="{category/name}"/>
                <Text id="_IDGenText9" text="{supplier/companyName}"/>
            </cells>
        </ColumnListItem>
    </items>
</Table>

    </Page>
</mvc:View>