<mvc:View controllerName="basic.controller.Detail"
    xmlns:mvc="sap.ui.core.mvc" xmlns:uxap="sap.uxap" xmlns:core="sap.ui.core" xmlns="sap.m">
    <uxap:ObjectPageLayout id="ObjectPageLayout">
        <uxap:headerTitle>
            <uxap:ObjectPageHeader id="_IDGenObjectPageHeader1" objectTitle="{productName}" />
        </uxap:headerTitle>
    
        <uxap:sections>
            <uxap:ObjectPageSection id="_IDGenObjectPageSection" title="General Details">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection id="_IDGenObjectPageSubSection">
                       
                        <core:Fragment fragmentName="basic.Fragments.ProductInfo" type="XML"/>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
            <uxap:ObjectPageSection id="_IDGenObjectPageSection2" title="Categories Info">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection id="_IDGenObjectPageSubSection2" binding="categories">
                        <VBox id="_IDGenVBox2" >
                            <Label id="_IDGenLabel5" text="Categories Name"></Label>
                            <Text id="_IDGenText12" text="{ID}" class="sapUiSmallMarginBottom"></Text>
                            
                            <Label id="_IDGenLabel6" text="Name"></Label>
                            <Text id="_IDGenText17" text="{category/name}" class="sapUiSmallMarginBottom"></Text>

                            <Label id="_IDGenLabel7" text="Description"></Label>
                            <Text id="_IDGenText18" text="description"></Text>
                        </VBox>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
            <uxap:ObjectPageSection id="_IDGenObjectPageSection1" title="Supplier Info">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection id="_IDGenObjectPageSubSection1" binding="{supplier}">
                        <VBox id="_IDGenVBox">
                            <Text id="_IDGenText1" text="supplier ID: {ID}"></Text>
                            <Text id="_IDGenText" text="Company: {companyName}"/>
                            <Text id="_IDGenText10" text="Contact Name: {contactName}"></Text>
                            <Text id="_IDGenText6" text="Email: {email}"/>
                            <Text id="_IDGenText11" text="Created At: {createdAt}" ></Text>
                            <Text id="_IDGenText13" text="Created By: {createdBy}"></Text>
                            <Text id="_IDGenText14" text="modifiedAt: {modifiedAt}"></Text>
                            <Text id="_IDGenText15" text="modifiedBy: {modifiedBy}"></Text>
                        </VBox>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
        </uxap:sections>
    </uxap:ObjectPageLayout>
</mvc:View>
